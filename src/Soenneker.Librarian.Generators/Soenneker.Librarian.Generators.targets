<Project>
    <Target Name="ValidateSoennekerLibrarianGeneratorsTargetFramework" BeforeTargets="PrepareForBuild;CoreCompile"
            Condition="'$(TargetFramework)' != '' and '$(IsCrossTargetingBuild)' != 'true'">
        <Error Condition="'$(TargetFrameworkIdentifier)' != '.NETCoreApp' or !$([MSBuild]::VersionGreaterThanOrEquals('$(TargetFrameworkVersion)', '10.0'))"
               Text="Soenneker.Librarian.Generators requires a consumer targeting .NET 10 or later. Current target: $(TargetFramework)." />
    </Target>
</Project>
