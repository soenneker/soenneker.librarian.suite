<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
        <Features Condition="'$(TargetFramework)' == 'net11.0'">$(Features);runtime-async=on</Features>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RazorSitemapEnabled>true</RazorSitemapEnabled>
    <RazorSitemapBaseUrl>https://librarian.soenneker.com/</RazorSitemapBaseUrl>
    <RazorSitemapOutputPath>wwwroot/sitemap.xml</RazorSitemapOutputPath>
    <RazorSitemapIncludeUnannotatedPages>true</RazorSitemapIncludeUnannotatedPages>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**;out/**;node_modules/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Soenneker.Gen.Razor.Sitemaps" Version="11.0.170" PrivateAssets="all" />
    <PackageReference Include="Soenneker.Quark.Suite" Version="11.0.1622" />
    <EmbeddedResource Include="../../benchmarks/Soenneker.Librarian.Benchmarks/sqlite-net-results.csv" LogicalName="Librarian.BenchmarkComparison.csv" />
  </ItemGroup>
</Project>
